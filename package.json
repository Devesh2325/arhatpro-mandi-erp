{
  "name": "arhatpro-mandi-erp",
  "version": "2.0.0",
  "description": "Full-Stack Enterprise Mandi ERP with React Frontend, Node.js/Express Backend & Relational SQL Database",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "install-all": "npm install",
    "runner": "concurrently --kill-others-on-fail --names \"SERVER,CLIENT\" --prefix-colors \"bgBlue.bold,bgGreen.bold\" \"node server/index.js\" \"npm --prefix client run dev\"",
    "dev": "npm run runner"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0"
  },
  "author": "Devesh Chaturvedi",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
