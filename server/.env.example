# ==========================================================
# ArhatPro Mandi ERP - Supabase Cloud Configuration (.env)
# ==========================================================

# 1. Supabase PostgreSQL Direct / Pooler Connection String
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
# Example: postgresql://postgres.xxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# 2. Supabase API Credentials (Optional - for Storage / Realtime)
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 3. Server Port
PORT=5000
